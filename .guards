# tw-web — load-bearing identifiers. `.tools/check-guards.py` fails the commit if one goes missing.
# Format: file:identifier (matched on word boundaries). Add a line when you write something
# that other files, the fleet's hooks or the security model depend on.
# Wiring between the JS files (who defines what, in which order) is .tools/check-refs.py's job.

# ── Security (S1–S11): the request guard and what it calls ────────────────────
app.py:def _guard_request
app.py:@app.before_request
app.py:def _origin_allowed
app.py:def _allowed_hosts
app.py:def _server_options
app.py:_EXTENSION_ROUTES
app.py:static_folder=None
app.py:def _is_asset
app.py:def _open_allowed
app.py:def _launch_argv
app.py:def _runtime_dir
app.py:def _private_dir

# ── The one path to `task` (timeout, rc.confirmation=no, readonly → rc.hooks=off) ──
app.py:def run_task_command
app.py:readonly=True

# ── Fleet contract shared with hooks (names must not change) ─────────────────
app.py:TW_NOINTERACT
app.py:TW_SPOOL_DIR
app.py:TW_CLIENT
app.py:TW_INTERACTIVE_REQUIRED
app.py:tw_needs_pty
app.py:def _pty_env
app.py:def _pty_argv
app.py:def _hook_signals
app.py:def _console_cmd
app.py:_NONINTERACTIVE_VARS

# ── Runtime paths: computed in three places, kept in step (S9) ──────────────────
tw-web-launch.sh:RUN_DIR
tw-web-launch.sh:stop_tw_web_procs

# ── Data safety: snapshot ~/.task on every launch (phase 6) ──────────────────
tw-web-launch.sh:snapshot -m
tw-web-launch.sh:config check
tw-web-native-host.py:RUN_DIR
tw-web-native-host.py:def stop_tw_web_procs

# ── Test isolation: the scratch server's own settings file ───────────────────
app.py:TW_WEB_SETTINGS
.tools/scratch-server.sh:TW_WEB_SETTINGS
tests/e2e/lib.cjs:TW_WEB_SETTINGS

